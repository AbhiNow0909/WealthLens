# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google AI Studio
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-key
# Optional: override the Gemini model (default gemini-1.5-pro)
GEMINI_MODEL=gemini-3.1-flash-lite

# App
# In production set this to your deployed frontend URL (used for CORS)
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
RISK_FREE_RATE=0.065
# Days to keep generated report files before the nightly cleanup prunes them
REPORT_RETENTION_DAYS=7
